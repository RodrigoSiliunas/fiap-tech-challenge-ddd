# Valores de demonstração. Não use em produção.
DATABASE_URL=postgresql+psycopg://oficina:oficina@localhost:5432/oficina
# Sem JWT_SECRET, a API gera um segredo aleatório a cada subida.
# Defina um valor longo e secreto para os tokens sobreviverem a reinícios.
# JWT_SECRET=
JWT_EXPIRE_MINUTES=120
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NOME=Administrador da Oficina
